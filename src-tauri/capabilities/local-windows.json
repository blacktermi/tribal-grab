{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-windows",
  "description": "Fenêtres locales de l'application (fichier généré par build.rs).",
  "local": true,
  "windows": ["main", "prefs", "library", "tray"],
  "webviews": ["browser-ui"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "allow-answer",
    "allow-app-info",
    "allow-bookmark-toggle",
    "allow-bootstrap-status",
    "allow-browser-state",
    "allow-cancel",
    "allow-cancel-all",
    "allow-check-ytdlp-update",
    "allow-clear-finished",
    "allow-clear-inactive",
    "allow-close-quicklook",
    "allow-export-integration-file",
    "allow-extension-install",
    "allow-get-app-prefs",
    "allow-get-settings",
    "allow-guided-clear-media",
    "allow-guided-history-clear",
    "allow-guided-layout",
    "allow-guided-mute",
    "allow-guided-nav",
    "allow-guided-navigate",
    "allow-guided-page-visible",
    "allow-guided-send",
    "allow-history",
    "allow-history-clear",
    "allow-history-delete",
    "allow-history-export-file",
    "allow-history-import-file",
    "allow-history-redownload",
    "allow-history-remove-missing",
    "allow-import-links-file",
    "allow-install-integration",
    "allow-integration-read-file",
    "allow-integrations",
    "allow-list-sounds",
    "allow-login-disable",
    "allow-login-save",
    "allow-login-status",
    "allow-move-task",
    "allow-open-path",
    "allow-open-window",
    "allow-pause",
    "allow-pause-all",
    "allow-play-sound",
    "allow-probe",
    "allow-quicklook",
    "allow-quit-app",
    "allow-read-clipboard",
    "allow-remove",
    "allow-remove-integration",
    "allow-reset-queue",
    "allow-resume",
    "allow-resume-all",
    "allow-retry",
    "allow-reveal-in-finder",
    "allow-save-integration",
    "allow-search",
    "allow-set-app-prefs",
    "allow-set-integration-enabled",
    "allow-set-priority",
    "allow-set-proxy-password",
    "allow-set-schedule",
    "allow-set-settings",
    "allow-set-task-speed-limit",
    "allow-set-tool-path",
    "allow-site-data-clear",
    "allow-site-data-clear-all",
    "allow-site-data-list",
    "allow-sites",
    "allow-start-queue",
    "allow-stop-recording",
    "allow-task-add",
    "allow-task-add-text",
    "allow-task-add-url",
    "allow-tasks",
    "allow-test-integration",
    "allow-tools",
    "allow-update-ytdlp"
  ]
}
