{
  "manifest_version": 3,
  "name": "Tribal Grab",
  "version": "0.1.0",
  "description": "Confie les téléchargements de Chrome à Tribal Grab (macOS) : plus rapides, avec pause et reprise.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "storage", "contextMenus", "downloads"],
  "action": {
    "default_title": "Envoyer à Tribal Grab",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
